# Copy this file to .env and fill in your values.
# Never commit .env to the repo.

# LLM provider (use one or both)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: model overrides (defaults will be set in pipeline config)
# ANTHROPIC_MODEL=claude-sonnet-4-6
# OPENAI_MODEL=gpt-4o

# LangSmith observability (disabled until explicitly enabled)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=asterline
# Keep both enabled in production so feedback, prompts, context, and model
# responses are never sent as trace inputs or outputs.
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
# Optional when an API key can access more than one LangSmith workspace.
# LANGSMITH_WORKSPACE_ID=
